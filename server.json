{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aarifmms/keyblind",
  "title": "Keyblind",
  "version": "0.8.8",
  "description": "Encrypted secrets vault for AI agents. 27 MCP tools resolve secrets at runtime, never leaking them.",
  "websiteUrl": "https://keyblind.dev",
  "repository": {
    "url": "https://github.com/aarifmms/keyblind",
    "source": "github"
  },
  "license": "MIT",
  "packages": [
    {
      "identifier": "keyblind",
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "version": "0.8.8",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        },
        {
          "type": "positional",
          "valueHint": "package_name",
          "value": "keyblind"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "start"
        }
      ]
    }
  ]
}
