{
  "name": "keyblind",
  "version": "0.8.7",
  "description": "Blind AI to your keys — encrypted secrets vault with MCP for AI agents",
  "mcpName": "io.github.aarifmms/keyblind",
  "type": "module",
  "bin": {
    "keyblind": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build.mjs && node scripts/build-dashboard.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "secrets",
    "vault",
    "encryption",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "security",
    "api-keys",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "license": "MIT",
  "author": "Keyblind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarifmms/keyblind.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^11.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.3.0",
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4",
    "hono": "4.13.13",
    "@hono/node-server": "1.19.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  }
}
